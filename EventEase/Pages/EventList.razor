            new EventModel { Name = "Vendor Expo", Date = DateTime.Now.AddDays(53), Location = "Exhibition Center" },
            new EventModel { Name = "End of Year Celebration", Date = DateTime.Now.AddDays(60), Location = "Banquet Hall" }
